FLASK_ENV=development
SECRET_KEY=change-me-in-production

# MySQL connection (used automatically when DB_NAME is set and DATABASE_URL is not)
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Fleet

# Alternative: set DATABASE_URL directly to override the above (e.g. sqlite:///fms_dev.db)
# DATABASE_URL=sqlite:///fms_dev.db

REDIS_URL=redis://localhost:6379/0
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5

# Origins allowed to call the REST API (comma-separated, exact match).
# Vite dev server, plus the Android WebView's own origin -- a Capacitor
# app on Android reports Origin: http://localhost regardless of which
# host it is calling, so without this entry every API call from the APK
# fails preflight with a CORS error that looks like the server is down.
CORS_ORIGINS=http://localhost:5173,http://localhost

# Flask must listen on all interfaces, not 127.0.0.1, for a phone on the
# same WiFi to reach it. In PyCharm set the run configuration host to
# 0.0.0.0; Windows Firewall will then prompt to allow inbound :8000, and
# that prompt must be accepted or the phone sees nothing.
