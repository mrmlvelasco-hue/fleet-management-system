# Copy to .env and edit BEFORE the first `docker compose up`.
# MySQL reads the passwords only when it first initialises its data
# directory -- changing them afterwards has no effect unless you also
# remove the fms_db_data volume.

# --- Security -------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database -------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=fms
DB_USER=fms_app
DB_PASSWORD=change-me-app

# Raise once you know the host's spare RAM. 128M is MySQL's default and
# is low for this workload.
MYSQL_BUFFER_POOL=512M

# --- Application ----------------------------------------------------
FLASK_ENV=production
WEB_PORT=8000
SESSION_TIMEOUT_MINUTES=30

# Set on the FIRST run to create the admin account and seed reference
# data. Safe to leave set (seeding is idempotent); clear it if you would
# rather the seed step were skipped on restart.
FMS_ADMIN_PASSWORD=change-me-admin

# --- Email (optional) -----------------------------------------------
MAIL_SERVER=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
